{
  "entities": {
    "photos": {
      "title": "Photo Records",
      "description": "User memories and captured photos stored persistently in Firestore",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "imageUrl": { "type": "string" },
        "title": { "type": "string" },
        "caption": { "type": "string" },
        "timestamp": { "type": "number" },
        "dateFormatted": { "type": "string" },
        "favorite": { "type": "boolean" },
        "tag": { "type": "string" },
        "filter": { "type": "string" },
        "location": { "type": "string" }
      },
      "required": ["id", "imageUrl", "title", "timestamp", "favorite"]
    },
    "community_posts": {
      "title": "Community Posts",
      "description": "Community posts and shared memory cards",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "author": { "type": "string" },
        "avatarBg": { "type": "string" },
        "timeAgo": { "type": "string" },
        "title": { "type": "string" },
        "imageUrl": { "type": "string" },
        "likes": { "type": "number" },
        "comments": { "type": "number" },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "author", "title", "imageUrl", "likes"]
    },
    "chat_messages": {
      "title": "Chat Messages",
      "description": "Companion conversation logs",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sender": { "type": "string" },
        "text": { "type": "string" },
        "timestamp": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "sender", "text"]
    },
    "email_notifications": {
      "title": "Email Notifications Audit Log",
      "description": "Audit log of automatic and manual email alert dispatches",
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "sentTo": { "type": "string" },
        "createdAt": { "type": "number" },
        "deliverySuccess": { "type": "boolean" },
        "deliveryProvider": { "type": "string" }
      },
      "required": ["type", "title", "sentTo", "createdAt"]
    },
    "app_config": {
      "title": "App Notification Config",
      "description": "Shared notification relay settings across devices",
      "type": "object",
      "properties": {
        "web3formsKey": { "type": "string" },
        "formsubmitTarget": { "type": "string" },
        "updatedAt": { "type": "number" }
      }
    },
    "presence": {
      "title": "Live Presence",
      "description": "Most recent web activity status",
      "type": "object",
      "properties": {
        "lastActiveTimestamp": { "type": "number" },
        "lastOpenedTimestamp": { "type": "number" },
        "lastOpenedFormatted": { "type": "string" },
        "deviceType": { "type": "string" },
        "isOnline": { "type": "boolean" }
      }
    },
    "web_sessions": {
      "title": "Web Session Logs",
      "description": "Recent visit open/close duration logs",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "clientId": { "type": "string" },
        "startTime": { "type": "number" },
        "endTime": { "type": "number" },
        "deviceType": { "type": "string" }
      },
      "required": ["id", "clientId", "startTime", "endTime"]
    }
  }
}
