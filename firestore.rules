rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
  match /databases/ai-studio-buddytobuddy-a8ce1d2f-7d9a-4de7-ade2-f9e8f7090468/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
